# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Supabase (create project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # server-only, never expose to client

# Anthropic Claude (calls routed via Vercel hkg1 edge region)
ANTHROPIC_API_KEY=sk-ant-

# Resend (custom sending domain per DESIGN.md §auth)
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@mail.first100.io

# Optional: Vercel pull for env sync in dev
# VERCEL_OIDC_TOKEN=
