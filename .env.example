# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Supabase (create project at supabase.com)
# Uses 2025 key format: sb_publishable_... and sb_secret_... .
# Legacy JWT keys (eyJhbGc...) also work if you have an older project.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx  # server-only, never expose to client; rotate before prod

# Anthropic Claude (calls routed via Vercel hkg1 edge region)
ANTHROPIC_API_KEY=sk-ant-

# Resend (custom sending domain per DESIGN.md §auth)
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@yourfirst100.co

# Optional: Vercel pull for env sync in dev
# VERCEL_OIDC_TOKEN=

# Cron secret — required for /api/cron/weekly-poster.  Generate with:
#   bun -e 'console.log(crypto.randomBytes(32).toString("hex"))'
# Set the SAME value in vault.secrets.cron_secret in Supabase.
CRON_SECRET=
